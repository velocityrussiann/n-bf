# Neon Beats Factory (NBF) - Environment Configuration

# Channel & Branding
CHANNEL_NAME="Neon Beats Factory"
SHOW_SONG_TITLE=false

# Visualizer & Image Processing
BG_DARKEN_FACTOR=0.50             # Darkening mask multiplier (0.40 - 0.60) to prevent neon washout
VISUALIZER_COLOR=variety          # variety (10-day anti-repetition), auto, complementary, or specific palette name
VISUALIZER_DIAMETER=688           # Pixel diameter of the 3D topographic core on 1080p canvas
LOCAL_OUTPUT_DIR="Processed_Videos"

# Pollinations AI (SEO Title & Description Generator)
POLLINATIONS_API_KEY=""           # Pollinations API key for high-CTR EDM metadata
POLLINATIONS_ENDPOINT="https://gen.pollinations.ai/v1/chat/completions"

# Google Drive Integration (Leave blank to use local input_audio / input_images folders)
GOOGLE_DRIVE_AUDIO_FOLDER_ID=""
GOOGLE_DRIVE_IMAGE_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_KEY=""     # Path to service_account.json OR raw JSON string

# YouTube API (OAuth 2.0 Credentials)
YT_CLIENT_ID=""
YT_CLIENT_SECRET=""
YT_REFRESH_TOKEN=""
YT_PRIVACY_STATUS="public"        # public, unlisted, private

# YouTube Playlist Automation
YT_PLAYLIST_TITLE="Neon Beats Factory | Best Electronic Dance Music & EDM Hits"
YT_PLAYLIST_DESC="Official playlist by Neon Beats Factory (NBF). Featuring high-energy electronic dance music, electro house, slap house, cyberpunk beats, and festival anthems."
YT_PLAYLIST_ID=""                 # Leave empty to automatically find or create by title

# Facebook Page Integration
FB_PAGE_ID="538586562680121"      # Neon Beats Factory Facebook Page ID
FB_PAGE_ACCESS_TOKEN=""           # Facebook Page Access Token (or META_LONG_LIVED_ACCESS_TOKEN)

# Repost Mode (When all songs have been published, recycle random pairs so uploads never stop)
ALLOW_REPOST=true
